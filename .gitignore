# disque, il y déplace ce qui doit disparaître. 120 Mo qui n'ont rien à faire ici.
_to_delete/

# --- archives de travail ---
*.zip
*.tgz
*.tar.gz

# --- rendus obsolètes ---
# Sounds_spatialized/ est l'ANCIENNE génération de rendus binauraux (14 Mo),
# entièrement remplacée par app/public/sfx/. On garde les sources (Sounds/,
# Sounds_edit/) et les rendus SERVIS (app/public/sfx/), pas les intermédiaires.
Sounds_spatialized/

# --- fichiers d'écoute temporaires produits lors des mises au point ---
/ecoute_*.mp3

